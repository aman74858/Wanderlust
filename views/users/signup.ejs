<% layout("/layouts/boilerplates") %>

<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-5">
    <div class="form-card">

      <!-- Role Toggle Tabs -->
      <div class="d-flex p-1 bg-light rounded-4 mb-4 border">
        <a href="/signup?role=guest" class="btn flex-grow-1 rounded-pill <%= typeof selectedRole === 'undefined' || selectedRole !== 'host' ? 'btn-white shadow-sm fw-bold bg-white text-dark' : 'text-muted' %>">
          <i class="fa-solid fa-user me-1 text-danger"></i>Traveler Account
        </a>
        <a href="/signup?role=host" class="btn flex-grow-1 rounded-pill <%= typeof selectedRole !== 'undefined' && selectedRole === 'host' ? 'btn-white shadow-sm fw-bold bg-white text-danger' : 'text-muted' %>">
          <i class="fa-solid fa-hotel me-1 text-danger"></i>Host Account
        </a>
      </div>

      <div class="text-center mb-4">
        <div class="navbar-brand justify-content-center mb-2">
          <i class="fa-solid fa-compass fs-1"></i>
        </div>
        <% if (typeof selectedRole !== 'undefined' && selectedRole === 'host') { %>
          <h3 class="fw-bold mb-1">Become a Wanderlust Host</h3>
          <p class="text-muted small">List your apartments, villas, and stays to start earning</p>
        <% } else { %>
          <h3 class="fw-bold mb-1">Join as a Traveler</h3>
          <p class="text-muted small">Discover and reserve one-of-a-kind places around the world</p>
        <% } %>
      </div>

      <form action="/signup" method="POST" novalidate class="needs-validation">
        <!-- Hidden Role Field -->
        <input type="hidden" name="role" value="<%= (typeof selectedRole !== 'undefined' && selectedRole === 'host') ? 'host' : 'guest' %>">

        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
            <input 
              type="text" 
              id="username" 
              placeholder="Choose a username" 
              name="username" 
              class="form-control" 
              required
            >
            <div class="invalid-feedback">Please enter a valid username.</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email address</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
            <input 
              type="email" 
              id="email" 
              placeholder="name@example.com" 
              name="email" 
              class="form-control" 
              required
            >
            <div class="invalid-feedback">Please enter a valid email address.</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="phone" class="form-label">Phone Number (optional)</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="fa-solid fa-phone text-muted"></i></span>
            <input 
              type="tel" 
              id="phone" 
              placeholder="+91 98765 43210" 
              name="phone" 
              class="form-control"
            >
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
            <input 
              type="password" 
              id="password" 
              placeholder="Create a strong password" 
              name="password" 
              class="form-control" 
              required
            >
            <div class="invalid-feedback">Please create a password.</div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
          <%= (typeof selectedRole !== 'undefined' && selectedRole === 'host') ? 'Sign up as Host' : 'Sign up as Traveler' %>
        </button>

        <div class="text-center">
          <span class="text-muted small">Already have an account? </span>
          <a href="/login<%= (typeof selectedRole !== 'undefined' && selectedRole === 'host') ? '?role=host' : '?role=guest' %>" class="text-danger fw-semibold small text-decoration-none">
            Log in as <%= (typeof selectedRole !== 'undefined' && selectedRole === 'host') ? 'Host' : 'Traveler' %>
          </a>
        </div>
      </form>
    </div>
  </div>
</div>