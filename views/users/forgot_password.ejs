<% layout("/layouts/boilerplates") %>

<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-5">
    <div class="form-card">
      
      <!-- Brand & Header -->
      <div class="text-center mb-4">
        <div class="navbar-brand justify-content-center mb-2">
          <i class="fa-solid fa-compass fs-1 text-danger"></i>
        </div>
        <div class="bg-danger-subtle text-danger rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
          <i class="fa-solid fa-key fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1">Forgot Password?</h3>
        <p class="text-muted small mb-0">
          No worries! Enter your registered username or email address, and we'll help you securely reset your password.
        </p>
      </div>

      <!-- Forgot Password Form -->
      <form action="/forgot-password" method="POST" novalidate class="needs-validation">
        <div class="mb-4">
          <label for="identifier" class="form-label">Username or Email Address</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="fa-solid fa-user-shield text-muted"></i></span>
            <input 
              type="text" 
              id="identifier" 
              name="identifier" 
              placeholder="e.g. johndoe or user@example.com" 
              class="form-control" 
              required
              autofocus
            >
            <div class="invalid-feedback">Please provide your username or email address.</div>
          </div>
          <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">
            <i class="fa-solid fa-shield-halved text-success me-1"></i>We'll verify your account credentials securely.
          </small>
        </div>

        <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3 shadow-sm">
          <i class="fa-solid fa-arrow-right me-1"></i>Verify & Reset Password
        </button>

        <div class="text-center pt-2 border-top">
          <a href="/login" class="text-dark small text-decoration-none fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Login
          </a>
        </div>
      </form>

    </div>
  </div>
</div>

