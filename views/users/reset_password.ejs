<% layout("/layouts/boilerplates") %>

<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-5">
    <div class="form-card">
      
      <!-- Brand & Header -->
      <div class="text-center mb-4">
        <div class="navbar-brand justify-content-center mb-2">
          <i class="fa-solid fa-compass fs-1 text-danger"></i>
        </div>
        <div class="bg-success-subtle text-success rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
          <i class="fa-solid fa-lock-open fs-4"></i>
        </div>
        <h3 class="fw-bold mb-1">Set New Password</h3>
        <p class="text-muted small mb-0">
          Resetting password for account: <b class="text-dark">@<%= user.username %></b>
          <br>
          <span class="text-secondary small">(<%= user.email %>)</span>
        </p>
      </div>

      <!-- Reset Password Form -->
      <form action="/reset-password/<%= token %>" method="POST" id="resetPasswordForm" novalidate class="needs-validation">
        
        <!-- New Password Field -->
        <div class="mb-3">
          <label for="password" class="form-label">New Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
            <input 
              type="password" 
              id="password" 
              name="password" 
              placeholder="Enter at least 6 characters" 
              class="form-control" 
              minlength="6"
              required
              autofocus
            >
            <button class="btn btn-outline-secondary border-start-0 bg-light" type="button" id="togglePasswordBtn1" title="Toggle visibility">
              <i class="fa-regular fa-eye text-muted" id="toggleIcon1"></i>
            </button>
            <div class="invalid-feedback">Password must be at least 6 characters long.</div>
          </div>
          <!-- Password strength bar -->
          <div class="progress mt-2" style="height: 4px;">
            <div id="strengthBar" class="progress-bar bg-danger" role="progressbar" style="width: 0%"></div>
          </div>
          <small id="strengthText" class="text-muted" style="font-size: 0.75rem;">Password strength</small>
        </div>

        <!-- Confirm New Password Field -->
        <div class="mb-4">
          <label for="confirmPassword" class="form-label">Confirm New Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="fa-solid fa-check-double text-muted"></i></span>
            <input 
              type="password" 
              id="confirmPassword" 
              name="confirmPassword" 
              placeholder="Re-enter your new password" 
              class="form-control" 
              minlength="6"
              required
            >
            <button class="btn btn-outline-secondary border-start-0 bg-light" type="button" id="togglePasswordBtn2" title="Toggle visibility">
              <i class="fa-regular fa-eye text-muted" id="toggleIcon2"></i>
            </button>
            <div class="invalid-feedback" id="confirmFeedback">Please confirm your password.</div>
          </div>
          <small id="matchStatus" class="d-block mt-1" style="font-size: 0.78rem;"></small>
        </div>

        <button type="submit" id="submitBtn" class="btn btn-primary-custom w-100 py-2 mb-3 shadow-sm">
          <i class="fa-solid fa-shield-check me-1"></i>Update Password
        </button>

        <div class="text-center pt-2 border-top">
          <a href="/login" class="text-dark small text-decoration-none fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Login
          </a>
        </div>
      </form>

    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Show / Hide password toggles
    const setupToggle = (btnId, inputId, iconId) => {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (btn && input && icon) {
        btn.addEventListener("click", () => {
          const isPassword = input.getAttribute("type") === "password";
          input.setAttribute("type", isPassword ? "text" : "password");
          icon.classList.toggle("fa-eye", !isPassword);
          icon.classList.toggle("fa-eye-slash", isPassword);
        });
      }
    };

    setupToggle("togglePasswordBtn1", "password", "toggleIcon1");
    setupToggle("togglePasswordBtn2", "confirmPassword", "toggleIcon2");

    // Password strength check
    const password = document.getElementById("password");
    const confirmPassword = document.getElementById("confirmPassword");
    const strengthBar = document.getElementById("strengthBar");
    const strengthText = document.getElementById("strengthText");
    const matchStatus = document.getElementById("matchStatus");

    password.addEventListener("input", () => {
      const val = password.value;
      let strength = 0;
      if (val.length >= 6) strength += 30;
      if (val.length >= 8) strength += 20;
      if (/[A-Z]/.test(val)) strength += 25;
      if (/[0-9]/.test(val) || /[^A-Za-z0-9]/.test(val)) strength += 25;

      strengthBar.style.width = strength + "%";
      if (strength <= 30) {
        strengthBar.className = "progress-bar bg-danger";
        strengthText.textContent = "Weak password (use at least 6 characters)";
        strengthText.className = "text-danger";
      } else if (strength <= 70) {
        strengthBar.className = "progress-bar bg-warning";
        strengthText.textContent = "Moderate password (add numbers or uppercase)";
        strengthText.className = "text-warning";
      } else {
        strengthBar.className = "progress-bar bg-success";
        strengthText.textContent = "Strong password!";
        strengthText.className = "text-success";
      }

      checkMatch();
    });

    confirmPassword.addEventListener("input", checkMatch);

    function checkMatch() {
      if (!confirmPassword.value) {
        matchStatus.textContent = "";
        return;
      }
      if (password.value === confirmPassword.value) {
        matchStatus.textContent = "✓ Passwords match";
        matchStatus.className = "text-success d-block mt-1";
      } else {
        matchStatus.textContent = "✗ Passwords do not match";
        matchStatus.className = "text-danger d-block mt-1";
      }
    }
  });
</script>

