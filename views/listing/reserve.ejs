<% layout("/layouts/boilerplates") %>

<div class="container my-4">
  <!-- Back Button & Header -->
  <div class="mb-4">
    <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
      <i class="fa-solid fa-arrow-left me-1"></i>Back to listing
    </a>
    <h2 class="fw-bold mt-3 mb-1">Confirm and Pay</h2>
    <p class="text-muted">You are one step away from reserving your stay at <%= listing.title %></p>
  </div>

  <div class="row g-5">
    <!-- Left Column: Reservation & Guest Details Form -->
    <div class="col-lg-7">
      <form action="/listings/<%= listing._id %>/reserve" method="POST" class="needs-validation" novalidate id="reserveForm">
        
        <!-- Trip Details Card -->
        <div class="card p-4 border rounded-4 shadow-sm mb-4">
          <h5 class="fw-bold mb-3"><i class="fa-regular fa-calendar-check me-2 text-danger"></i>Your Trip</h5>
          
          <div class="row g-3">
            <div class="col-md-6">
              <label for="checkIn" class="form-label fw-semibold">Check-in Date</label>
              <input 
                type="date" 
                id="checkIn" 
                name="booking[checkIn]" 
                class="form-control" 
                value="<%= checkInDate %>" 
                required
              >
              <div class="invalid-feedback">Please select a check-in date.</div>
            </div>

            <div class="col-md-6">
              <label for="checkOut" class="form-label fw-semibold">Checkout Date</label>
              <input 
                type="date" 
                id="checkOut" 
                name="booking[checkOut]" 
                class="form-control" 
                value="<%= checkOutDate %>" 
                required
              >
              <div class="invalid-feedback">Please select a checkout date.</div>
            </div>

            <div class="col-12">
              <label for="guests" class="form-label fw-semibold">Number of Guests</label>
              <select class="form-select" id="guests" name="booking[guests]" required>
                <option value="1" <%= guests === 1 ? 'selected' : '' %>>1 guest</option>
                <option value="2" <%= guests === 2 ? 'selected' : '' %>>2 guests</option>
                <option value="3" <%= guests === 3 ? 'selected' : '' %>>3 guests</option>
                <option value="4" <%= guests === 4 ? 'selected' : '' %>>4 guests</option>
                <option value="5" <%= guests === 5 ? 'selected' : '' %>>5+ guests</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Guest Contact Info -->
        <div class="card p-4 border rounded-4 shadow-sm mb-4">
          <h5 class="fw-bold mb-3"><i class="fa-regular fa-address-card me-2 text-danger"></i>Guest Information</h5>

          <div class="row g-3">
            <div class="col-12">
              <label for="guestName" class="form-label fw-semibold">Full Name</label>
              <input 
                type="text" 
                id="guestName" 
                name="booking[guestName]" 
                class="form-control" 
                placeholder="Primary guest name" 
                value="<%= currUser ? currUser.username : '' %>" 
                required
              >
              <div class="invalid-feedback">Please enter your full name.</div>
            </div>

            <div class="col-md-6">
              <label for="guestEmail" class="form-label fw-semibold">Email for Confirmation</label>
              <input 
                type="email" 
                id="guestEmail" 
                name="booking[guestEmail]" 
                class="form-control" 
                placeholder="booking@example.com" 
                value="<%= currUser && currUser.email ? currUser.email : '' %>" 
                required
              >
              <div class="invalid-feedback">Please enter a valid email address.</div>
            </div>

            <div class="col-md-6">
              <label for="guestPhone" class="form-label fw-semibold">Phone Number</label>
              <input 
                type="tel" 
                id="guestPhone" 
                name="booking[guestPhone]" 
                class="form-control" 
                placeholder="+91 98765 43210" 
                required
              >
              <div class="invalid-feedback">Please enter a valid phone number.</div>
            </div>

            <div class="col-12">
              <label for="specialRequests" class="form-label fw-semibold">Special Requests (Optional)</label>
              <textarea 
                id="specialRequests" 
                name="booking[specialRequests]" 
                class="form-control" 
                rows="2" 
                placeholder="Early check-in, extra towels, airport pickup request..."
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Payment Method -->
        <div class="card p-4 border rounded-4 shadow-sm mb-4">
          <h5 class="fw-bold mb-3"><i class="fa-solid fa-credit-card me-2 text-danger"></i>Payment Method</h5>

          <div class="d-flex flex-column gap-3">
            <div class="form-check p-3 border rounded-3 d-flex align-items-center justify-content-between">
              <div>
                <input class="form-check-input ms-0 me-3" type="radio" name="booking[paymentMethod]" id="payCard" value="Credit / Debit Card" checked>
                <label class="form-check-label fw-semibold" for="payCard">
                  Credit / Debit Card
                </label>
                <div class="small text-muted ps-4">Visa, Mastercard, RuPay, Amex</div>
              </div>
              <div class="fs-4 text-secondary d-none d-sm-block">
                <i class="fa-brands fa-cc-visa me-1"></i>
                <i class="fa-brands fa-cc-mastercard"></i>
              </div>
            </div>

            <div class="form-check p-3 border rounded-3 d-flex align-items-center justify-content-between">
              <div>
                <input class="form-check-input ms-0 me-3" type="radio" name="booking[paymentMethod]" id="payUpi" value="UPI / GPay / PhonePe">
                <label class="form-check-label fw-semibold" for="payUpi">
                  UPI & QR (Instant)
                </label>
                <div class="small text-muted ps-4">Google Pay, PhonePe, Paytm, BHIM</div>
              </div>
              <div class="fs-5 text-secondary d-none d-sm-block">
                <i class="fa-solid fa-qrcode"></i>
              </div>
            </div>

            <div class="form-check p-3 border rounded-3 d-flex align-items-center justify-content-between">
              <div>
                <input class="form-check-input ms-0 me-3" type="radio" name="booking[paymentMethod]" id="payProperty" value="Pay at Property">
                <label class="form-check-label fw-semibold" for="payProperty">
                  Pay at Check-in
                </label>
                <div class="small text-muted ps-4">Zero prepayment required today</div>
              </div>
              <div class="fs-5 text-secondary d-none d-sm-block">
                <i class="fa-solid fa-hotel"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Cancellation Policy Note -->
        <div class="small text-muted mb-4">
          <p class="mb-1">
            <b>Cancellation policy:</b> Free cancellation up to 48 hours before check-in.
          </p>
          <p class="mb-0">
            By clicking "Confirm & Book", you agree to the Wanderlust Ground Rules for guests and Terms of Service.
          </p>
        </div>

        <button type="submit" class="btn btn-reserve w-100 py-3 fs-5">
          <i class="fa-solid fa-lock me-2"></i>Confirm & Book Stay
        </button>
      </form>
    </div>

    <!-- Right Column: Stay Summary & Price Breakdown Card -->
    <div class="col-lg-5">
      <div class="card p-4 border rounded-4 shadow-sm reserve-summary">
        <!-- Listing Thumbnail & Title -->
        <div class="d-flex gap-3 pb-3 border-bottom mb-3">
          <img 
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=60' %>" 
            alt="<%= listing.title %>" 
            class="rounded-3 shadow-sm"
            style="width: 100px; height: 80px; object-fit: cover;"
          >
          <div>
            <span class="badge bg-light text-dark border mb-1">Entire place</span>
            <h6 class="fw-bold mb-1"><%= listing.title %></h6>
            <div class="small text-muted">
              <i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %>
            </div>
          </div>
        </div>

        <!-- Price Breakdown -->
        <h6 class="fw-bold mb-3">Price Details</h6>
        
        <div class="small text-secondary">
          <div class="d-flex justify-content-between mb-2">
            <span>&#8377;<%= listing.price.toLocaleString("en-IN") %> &times; <span id="summaryNights">3</span> nights</span>
            <span class="fw-semibold text-dark">&#8377;<span id="summaryBasePrice"><%= (listing.price * 3).toLocaleString("en-IN") %></span></span>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span>Cleaning fee</span>
            <span class="fw-semibold text-dark">&#8377;800</span>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span>Wanderlust service fee (10%)</span>
            <span class="fw-semibold text-dark">&#8377;<span id="summaryServiceFee"><%= Math.round(listing.price * 3 * 0.1).toLocaleString("en-IN") %></span></span>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span>Taxes & GST (18%)</span>
            <span class="fw-semibold text-dark">&#8377;<span id="summaryTax"><%= Math.round((listing.price * 3 + 800 + Math.round(listing.price * 3 * 0.1)) * 0.18).toLocaleString("en-IN") %></span></span>
          </div>

          <hr class="my-3">

          <div class="d-flex justify-content-between fs-5 fw-bold text-dark pt-1">
            <span>Total (INR)</span>
            <span class="text-danger">&#8377;<span id="summaryTotal">
              <%= Math.round(listing.price * 3 + 800 + Math.round(listing.price * 3 * 0.1) + Math.round((listing.price * 3 + 800 + Math.round(listing.price * 3 * 0.1)) * 0.18)).toLocaleString("en-IN") %>
            </span></span>
          </div>
        </div>

        <!-- Protected Badge -->
        <div class="mt-4 p-3 bg-light rounded-3 d-flex align-items-center gap-3">
          <i class="fa-solid fa-shield-heart fs-3 text-danger"></i>
          <div class="small">
            <b>WanderCover Protection</b>
            <div class="text-muted">Every booking includes free protection from Host cancellations and listing inaccuracies.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Real-time calculation script for reservation dates
  document.addEventListener('DOMContentLoaded', () => {
    const pricePerNight = <%= listing.price %>;
    const checkInInput = document.getElementById('checkIn');
    const checkOutInput = document.getElementById('checkOut');
    const summaryNights = document.getElementById('summaryNights');
    const summaryBasePrice = document.getElementById('summaryBasePrice');
    const summaryServiceFee = document.getElementById('summaryServiceFee');
    const summaryTax = document.getElementById('summaryTax');
    const summaryTotal = document.getElementById('summaryTotal');

    function updateCalculations() {
      if (!checkInInput.value || !checkOutInput.value) return;
      const start = new Date(checkInInput.value);
      const end = new Date(checkOutInput.value);
      
      let nights = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
      if (nights <= 0) nights = 1;

      const base = pricePerNight * nights;
      const cleaning = 800;
      const service = Math.round(base * 0.10);
      const tax = Math.round((base + cleaning + service) * 0.18);
      const total = base + cleaning + service + tax;

      summaryNights.innerText = nights;
      summaryBasePrice.innerText = base.toLocaleString('en-IN');
      summaryServiceFee.innerText = service.toLocaleString('en-IN');
      summaryTax.innerText = tax.toLocaleString('en-IN');
      summaryTotal.innerText = total.toLocaleString('en-IN');
    }

    checkInInput.addEventListener('change', updateCalculations);
    checkOutInput.addEventListener('change', updateCalculations);
  });
</script>
