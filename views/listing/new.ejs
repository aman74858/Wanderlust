<% layout("/layouts/boilerplates") %>

<style>
  .category-choice-card {
    transition: all 0.2s ease;
    cursor: pointer;
    background: #ffffff;
    user-select: none;
    min-height: 86px;
    border: 1.5px solid #e2e8f0 !important;
  }
  .category-choice-card:hover {
    border-color: #fe424d !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(254, 66, 77, 0.12);
  }
  .category-choice-card.active {
    border-color: #fe424d !important;
    background-color: #fff1f2 !important;
    box-shadow: 0 0 0 1px #fe424d;
  }
  .category-choice-card.active span {
    color: #e00b41 !important;
    font-weight: 700 !important;
  }
  .category-choice-card.active i {
    color: #fe424d !important;
    transform: scale(1.15);
  }
</style>

<div class="row justify-content-center my-4">
  <div class="col-lg-8 col-md-10">
    <div class="form-card">
      <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <div class="host-avatar me-3" style="width: 44px; height: 44px; font-size: 1.1rem;">
          <i class="fa-solid fa-house-chimney"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0">Host your place</h3>
          <p class="text-muted small mb-0">Fill in the details to publish your listing on Wanderlust</p>
        </div>
      </div>

      <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label">Property Title</label>
          <input 
            type="text" 
            id="title" 
            placeholder="e.g. Luxury Seafront Villa with Infinity Pool" 
            name="listing[title]" 
            class="form-control" 
            required
          >
          <div class="valid-feedback">Looks great!</div>
          <div class="invalid-feedback">Please enter a catchy title for your listing.</div>
        </div>

        <!-- Property Category Selection -->
        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label mb-0 fw-semibold">
              <i class="fa-solid fa-icons text-danger me-1"></i>Property Category
            </label>
            <span class="badge bg-light text-muted border small">Select one</span>
          </div>
          <p class="text-muted small mb-2">Choose the category that best matches your stay so guests can discover it easily.</p>

          <!-- Visual Category Selector Grid -->
          <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 g-2" id="categoryPickerGrid">
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Rooms" class="d-none category-radio" checked required>
                <i class="fa-solid fa-bed fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Rooms</span>
              </label>
            </div>
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Iconic Cities" class="d-none category-radio">
                <i class="fa-solid fa-mountain-city fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Iconic Cities</span>
              </label>
            </div>
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Mountains" class="d-none category-radio">
                <i class="fa-solid fa-mountain fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Mountains</span>
              </label>
            </div>
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Castles" class="d-none category-radio">
                <i class="fa-brands fa-fort-awesome fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Castles</span>
              </label>
            </div>
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Amazing Pools" class="d-none category-radio">
                <i class="fa-solid fa-person-swimming fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Pools</span>
              </label>
            </div>
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Camping" class="d-none category-radio">
                <i class="fa-solid fa-campground fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Camping</span>
              </label>
            </div>
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Farms" class="d-none category-radio">
                <i class="fa-solid fa-cow fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Farms</span>
              </label>
            </div>
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Arctic" class="d-none category-radio">
                <i class="fa-regular fa-snowflake fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Arctic</span>
              </label>
            </div>
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Beachfront" class="d-none category-radio">
                <i class="fa-solid fa-umbrella-beach fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Beachfront</span>
              </label>
            </div>
            <div class="col">
              <label class="category-choice-card w-100 p-2 text-center rounded-3 d-flex flex-column align-items-center justify-content-center cursor-pointer h-100">
                <input type="radio" name="listing[category]" value="Boats" class="d-none category-radio">
                <i class="fa-solid fa-sailboat fs-4 mb-1 text-secondary"></i>
                <span class="small fw-semibold text-dark">Boats</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea 
            id="description" 
            placeholder="Describe the atmosphere, views, bedroom count, nearby attractions..." 
            name="listing[description]" 
            class="form-control" 
            rows="4" 
            required
          ></textarea>
          <div class="invalid-feedback">Please provide a brief description of the place.</div>
        </div>

        <!-- Multiple Photos Upload -->
        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="images" class="form-label mb-0 fw-semibold">
              <i class="fa-solid fa-images text-danger me-1"></i>Upload Property Photos
            </label>
            <span class="badge bg-light text-dark border small" id="photoCountBadge">
              <i class="fa-solid fa-camera me-1"></i>Multiple photos allowed (up to 10)
            </span>
          </div>
          <p class="text-muted small mb-2">Showcase your bedrooms, living area, kitchen, views, and bathrooms. The first photo will be your stay's main cover photo.</p>
          <input 
            type="file" 
            id="images" 
            name="listing[images]" 
            class="form-control"
            accept="image/*"
            multiple
          >
          <div class="form-text small text-muted">You can select multiple photos at once. Supported formats: JPG, PNG, WEBP.</div>
          
          <!-- Live Preview Container for selected photos -->
          <div id="photosPreviewContainer" class="row row-cols-3 row-cols-sm-4 row-cols-md-5 g-2 mt-2 d-none">
          </div>
        </div>

        <!-- Price and Country in a row -->
        <div class="row g-3 mb-3">
          <div class="col-md-5">
            <label for="price" class="form-label">Price per Night (&#8377;)</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0">&#8377;</span>
              <input 
                type="number" 
                id="price" 
                placeholder="2500" 
                name="listing[price]" 
                class="form-control border-start-0" 
                min="100" 
                required
              >
              <div class="invalid-feedback">Please enter a valid positive price.</div>
            </div>
          </div>

          <div class="col-md-7">
            <label for="country" class="form-label">Country</label>
            <input 
              type="text" 
              id="country" 
              placeholder="e.g. India" 
              name="listing[country]" 
              class="form-control" 
              required
            >
            <div class="invalid-feedback">Please specify the country.</div>
          </div>
        </div>

        <!-- Location -->
        <div class="mb-4">
          <label for="location" class="form-label">Location / City</label>
          <input 
            type="text" 
            id="location" 
            placeholder="e.g. Candolim, Goa" 
            name="listing[location]" 
            class="form-control" 
            required
          >
          <div class="invalid-feedback">Please provide the city or local area name.</div>
        </div>

        <!-- Submit Button -->
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary-custom px-4 py-2">
            <i class="fa-solid fa-plus me-2"></i>Create Listing
          </button>
          <a href="/listings" class="btn btn-outline-secondary px-4 py-2 rounded-3">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll(".category-choice-card");

    function updateActiveCategory() {
      cards.forEach((card) => {
        const radio = card.querySelector(".category-radio");
        if (radio && radio.checked) {
          card.classList.add("active");
        } else {
          card.classList.remove("active");
        }
      });
    }

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const radio = card.querySelector(".category-radio");
        if (radio) {
          radio.checked = true;
          updateActiveCategory();
        }
      });
    });

    updateActiveCategory();

    // Live Multiple Photos Preview
    const imageInput = document.getElementById("images");
    const previewContainer = document.getElementById("photosPreviewContainer");
    const photoCountBadge = document.getElementById("photoCountBadge");

    if (imageInput && previewContainer) {
      imageInput.addEventListener("change", (e) => {
        previewContainer.innerHTML = "";
        const files = Array.from(e.target.files);
        if (files.length > 0) {
          previewContainer.classList.remove("d-none");
          photoCountBadge.innerHTML = `<i class="fa-solid fa-check text-success me-1"></i>${files.length} photo${files.length > 1 ? 's' : ''} selected`;
          photoCountBadge.className = "badge bg-success-subtle text-success border border-success-subtle small";

          files.forEach((file, idx) => {
            if (!file.type.startsWith("image/")) return;
            const col = document.createElement("div");
            col.className = "col";
            const reader = new FileReader();
            reader.onload = (event) => {
              col.innerHTML = `
                <div class="position-relative border rounded-3 overflow-hidden shadow-sm" style="height: 80px;">
                  <img src="${event.target.result}" style="width: 100%; height: 100%; object-fit: cover;" alt="Preview">
                  ${idx === 0 ? '<span class="badge bg-dark position-absolute bottom-0 start-0 m-1" style="font-size: 0.65rem;">Cover</span>' : ''}
                </div>
              `;
            };
            reader.readAsDataURL(file);
            previewContainer.appendChild(col);
          });
        } else {
          previewContainer.classList.add("d-none");
          photoCountBadge.innerHTML = `<i class="fa-solid fa-camera me-1"></i>Multiple photos allowed (up to 10)`;
          photoCountBadge.className = "badge bg-light text-dark border small";
        }
      });
    }
  });
</script>
