<% layout("/layouts/boilerplates") %>

<div class="row justify-content-center my-5 py-4">
  <div class="col-md-7 col-lg-6 text-center">
    <div class="form-card text-center p-5">
      <div class="mb-3 text-danger">
        <i class="fa-solid fa-triangle-exclamation" style="font-size: 3.5rem;"></i>
      </div>
      <h2 class="fw-bold mb-2">Oops! Something went wrong</h2>
      <p class="text-muted mb-4">
        <%= (error && error.message) ? error.message : "The page you're looking for doesn't exist or an unexpected error occurred." %>
      </p>
      <div class="d-flex justify-content-center gap-2">
        <a href="/listings" class="btn btn-primary-custom px-4 py-2">
          <i class="fa-solid fa-house me-2"></i>Back to Home
        </a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2 rounded-3">
          Go Back
        </a>
      </div>
    </div>
  </div>
</div>
