<% layout("/layouts/boilerplates") %>

<div class="container mt-2 mb-5">
  <!-- Listing Header -->
  <div class="show-header">
    <h1 class="show-title"><%= listing.title %></h1>
    <div class="show-meta">
      <div>
        <span class="fw-semibold text-dark"><i class="fa-solid fa-star text-warning me-1"></i>4.92</span>
        &middot;
        <span class="text-decoration-underline fw-semibold"><%= listing.reviews ? listing.reviews.length : 0 %> reviews</span>
        &middot;
        <span><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %></span>
        <% if (listing.category) { %>
          &middot;
          <a href="/listings?category=<%= encodeURIComponent(listing.category) %>" class="badge bg-light text-dark border px-2 py-1 text-decoration-none">
            <i class="fa-solid fa-tag text-danger me-1"></i><%= listing.category %>
          </a>
        <% } %>
      </div>
      <div class="d-none d-md-flex gap-3">
        <button class="btn btn-sm btn-outline-dark rounded-pill px-3" type="button"><i class="fa-solid fa-arrow-up-from-bracket me-1"></i>Share</button>
        <button class="btn btn-sm btn-outline-dark rounded-pill px-3" type="button"><i class="fa-regular fa-heart me-1"></i>Save</button>
      </div>
    </div>
  </div>

<style>
  .photo-gallery-mosaic {
    border-radius: 1.25rem;
    overflow: hidden;
    background: #0f172a;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }
  .gallery-tile-main {
    height: 420px;
    overflow: hidden;
    cursor: pointer;
  }
  .gallery-tile-sub {
    overflow: hidden;
    cursor: pointer;
  }
  .gallery-img {
    transition: transform 0.4s ease, opacity 0.2s ease;
  }
  .gallery-tile-main:hover .gallery-img,
  .gallery-tile-sub:hover .gallery-img {
    transform: scale(1.03);
    opacity: 0.94;
  }
  .cursor-pointer {
    cursor: pointer;
  }
  .modal-gallery-img {
    max-height: 72vh;
    object-fit: contain;
    width: 100%;
  }
  .filmstrip-thumb {
    width: 64px;
    height: 48px;
    object-fit: cover;
    border-radius: 8px;
    cursor: pointer;
    opacity: 0.6;
    transition: all 0.2s ease;
    border: 2px solid transparent;
  }
  .filmstrip-thumb.active,
  .filmstrip-thumb:hover {
    opacity: 1;
    border-color: #fe424d;
    transform: scale(1.05);
  }
  @media (max-width: 768px) {
    .gallery-tile-main {
      height: 280px;
    }
  }
</style>

  <!-- Photo Gallery / Hero Display -->
  <% 
    const allPhotos = (listing.images && listing.images.length > 0) 
      ? listing.images 
      : (listing.image && listing.image.url ? [listing.image] : [{ url: (originalImageUrl || 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80') }]);
  %>

  <% if (allPhotos.length > 1) { %>
    <!-- Multi-Photo Gallery Mosaic -->
    <div class="position-relative mb-4">
      <div class="photo-gallery-mosaic">
        <div class="row g-2">
          <!-- Main Large Photo (Left Column) -->
          <div class="<%= allPhotos.length >= 3 ? 'col-md-7 col-12' : 'col-md-6 col-12' %>">
            <div class="gallery-tile-main h-100 position-relative cursor-pointer" data-bs-toggle="modal" data-bs-target="#galleryModal" data-photo-idx="0">
              <img src="<%= allPhotos[0].url %>" alt="<%= listing.title %> main photo" class="w-100 h-100 object-fit-cover gallery-img">
            </div>
          </div>

          <!-- Secondary Grid (Right Column) -->
          <div class="<%= allPhotos.length >= 3 ? 'col-md-5 col-12' : 'col-md-6 col-12' %>">
            <% if (allPhotos.length >= 5) { %>
              <!-- 4 photo grid -->
              <div class="row g-2 h-100">
                <% for (let i = 1; i <= 4; i++) { %>
                  <div class="col-6">
                    <div class="gallery-tile-sub cursor-pointer" data-bs-toggle="modal" data-bs-target="#galleryModal" data-photo-idx="<%= i %>" style="height: 206px;">
                      <img src="<%= allPhotos[i].url %>" alt="Photo <%= i + 1 %>" class="w-100 h-100 object-fit-cover gallery-img">
                    </div>
                  </div>
                <% } %>
              </div>
            <% } else if (allPhotos.length >= 3) { %>
              <!-- 2 photos stacked -->
              <div class="row g-2 h-100">
                <% for (let i = 1; i < Math.min(3, allPhotos.length); i++) { %>
                  <div class="col-12">
                    <div class="gallery-tile-sub cursor-pointer" data-bs-toggle="modal" data-bs-target="#galleryModal" data-photo-idx="<%= i %>" style="height: 206px;">
                      <img src="<%= allPhotos[i].url %>" alt="Photo <%= i + 1 %>" class="w-100 h-100 object-fit-cover gallery-img">
                    </div>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              <!-- 1 photo on right side -->
              <div class="gallery-tile-sub h-100 cursor-pointer" data-bs-toggle="modal" data-bs-target="#galleryModal" data-photo-idx="1" style="min-height: 420px;">
                <img src="<%= allPhotos[1].url %>" alt="Photo 2" class="w-100 h-100 object-fit-cover gallery-img">
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Floating "Show all photos" Button -->
      <button type="button" class="btn btn-white bg-white text-dark shadow-sm border rounded-pill px-3 py-2 position-absolute bottom-0 end-0 m-3 fw-semibold small" data-bs-toggle="modal" data-bs-target="#galleryModal">
        <i class="fa-solid fa-grip-vertical me-2 text-danger"></i>Show all <%= allPhotos.length %> photos
      </button>
    </div>
  <% } else { %>
    <!-- Single Hero Image Display -->
    <div class="show-image-container position-relative">
      <img
        src="<%= allPhotos[0].url %>"
        class="show-image"
        alt="<%= listing.title %>"
        style="cursor: pointer;"
        data-bs-toggle="modal"
        data-bs-target="#galleryModal"
      >
      <button type="button" class="btn btn-white bg-white text-dark shadow-sm border rounded-pill px-3 py-2 position-absolute bottom-0 end-0 m-3 fw-semibold small" data-bs-toggle="modal" data-bs-target="#galleryModal">
        <i class="fa-solid fa-expand me-1"></i>View Fullscreen
      </button>
    </div>
  <% } %>

  <!-- Content Grid: Details (Left) & Booking Card (Right) -->
  <div class="row g-5">
    <!-- Left Column: Details -->
    <div class="col-lg-7">
      <!-- Host Info -->
      <div class="host-info-card">
        <div class="host-avatar">
          <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
        </div>
        <div>
          <h5 class="fw-bold mb-1">Hosted by <%= listing.owner ? listing.owner.username : 'Wanderlust Host' %></h5>
          <p class="text-muted small mb-0">Superhost &middot; 2 years hosting</p>
        </div>
      </div>

      <!-- Highlights -->
      <div class="py-4 border-bottom">
        <div class="d-flex align-items-start gap-3 mb-3">
          <i class="fa-solid fa-key fs-4 text-secondary mt-1"></i>
          <div>
            <h6 class="fw-bold mb-0">Self check-in</h6>
            <p class="text-muted small mb-0">Check yourself in with the smart lock.</p>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3 mb-3">
          <i class="fa-solid fa-medal fs-4 text-secondary mt-1"></i>
          <div>
            <h6 class="fw-bold mb-0">Experienced host</h6>
            <p class="text-muted small mb-0"><%= listing.owner ? listing.owner.username : 'Host' %> has 100% 5-star ratings from recent guests.</p>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3">
          <i class="fa-solid fa-calendar-check fs-4 text-secondary mt-1"></i>
          <div>
            <h6 class="fw-bold mb-0">Free cancellation</h6>
            <p class="text-muted small mb-0">Cancel up to 48 hours before check-in for a full refund.</p>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-3">About this space</h5>
        <p class="text-secondary" style="line-height: 1.7; white-space: pre-line;"><%= listing.description %></p>
      </div>

      <!-- What this place offers -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-3">What this place offers</h5>
        <div class="row row-cols-2 g-3">
          <div class="col amenity-item"><i class="fa-solid fa-wifi"></i> Fast high-speed WiFi</div>
          <div class="col amenity-item"><i class="fa-solid fa-square-parking"></i> Free parking on premises</div>
          <div class="col amenity-item"><i class="fa-solid fa-kitchen-set"></i> Fully equipped kitchen</div>
          <div class="col amenity-item"><i class="fa-solid fa-snowflake"></i> Air conditioning</div>
          <div class="col amenity-item"><i class="fa-solid fa-tv"></i> 55" 4K Smart TV</div>
          <div class="col amenity-item"><i class="fa-solid fa-water-ladder"></i> Private swimming pool</div>
          <div class="col amenity-item"><i class="fa-solid fa-shield-halved"></i> 24/7 Security & CCTV</div>
          <div class="col amenity-item"><i class="fa-solid fa-mug-hot"></i> Coffee maker & essentials</div>
        </div>
      </div>

      <!-- Owner Actions (Edit / Delete) -->
      <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="py-4 border-bottom d-flex gap-3">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4">
            <i class="fa-solid fa-pen-to-square me-2"></i>Edit Listing
          </a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button type="submit" class="btn btn-outline-danger rounded-pill px-4" onclick="return confirm('Are you sure you want to delete this listing?');">
              <i class="fa-solid fa-trash me-2"></i>Delete
            </button>
          </form>
        </div>
      <% } %>
    </div>

    <!-- Right Column: Sticky Booking Simulation Card -->
    <div class="col-lg-5">
      <div class="booking-card">
        <div class="booking-price-header">
          <div>
            <span class="booking-price-amount">&#8377;<%= listing.price ? Number(listing.price).toLocaleString("en-IN") : "0" %></span>
            <span class="text-muted"> / night</span>
          </div>
          <div class="small fw-semibold text-dark">
            <i class="fa-solid fa-star text-warning"></i> 4.92 &middot; <span class="text-muted"><%= listing.reviews ? listing.reviews.length : 0 %> reviews</span>
          </div>
        </div>

        <!-- Date & Guests Widget -->
        <div class="booking-inputs-grid">
          <div class="row g-0 border-bottom">
            <div class="col-6 border-end booking-input-cell">
              CHECK-IN
              <span>Oct 12, 2026</span>
            </div>
            <div class="col-6 booking-input-cell">
              CHECKOUT
              <span>Oct 17, 2026</span>
            </div>
          </div>
          <div class="booking-input-cell">
            GUESTS
            <span>2 guests, 1 room</span>
          </div>
        </div>

        <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
          <div class="alert alert-light border text-center py-3 mb-3">
            <i class="fa-solid fa-house-user text-danger fs-4 mb-2 d-block"></i>
            <b class="d-block">Your Property Listing</b>
            <small class="text-muted">You are hosting this property</small>
            <div class="d-flex gap-2 mt-2">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-dark flex-grow-1 rounded-pill">Edit</a>
              <a href="/host/dashboard" class="btn btn-sm btn-outline-danger flex-grow-1 rounded-pill">Host Portal</a>
            </div>
          </div>
        <% } else if (currUser && currUser.role === 'host') { %>
          <div class="alert alert-light border text-center py-2 mb-3">
            <small class="text-muted"><i class="fa-solid fa-hotel me-1 text-danger"></i>Viewing as Host</small>
          </div>
          <a href="/listings/<%= listing._id %>/reserve" class="btn btn-reserve mb-3 text-center text-decoration-none d-block">
            <i class="fa-solid fa-calendar-check me-2"></i>Reserve Stay
          </a>
        <% } else { %>
          <a href="/listings/<%= listing._id %>/reserve" class="btn btn-reserve mb-3 text-center text-decoration-none d-block">
            <i class="fa-solid fa-calendar-check me-2"></i>Reserve Stay
          </a>
        <% } %>

        <p class="text-center text-muted small mb-3">You won't be charged yet</p>

        <!-- Fee Breakdown -->
        <div class="small text-secondary">
          <div class="d-flex justify-content-between mb-2">
            <span class="text-decoration-underline">&#8377;<%= listing.price ? Number(listing.price).toLocaleString("en-IN") : "0" %> x 5 nights</span>
            <span>&#8377;<%= listing.price ? (Number(listing.price) * 5).toLocaleString("en-IN") : "0" %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-decoration-underline">Cleaning fee</span>
            <span>&#8377;1,200</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-decoration-underline">Wanderlust service fee</span>
            <span>&#8377;1,850</span>
          </div>
          <hr class="my-2">
          <div class="d-flex justify-content-between fw-bold text-dark fs-6 pt-1">
            <span>Total before taxes</span>
            <span>&#8377;<%= listing.price ? (Number(listing.price) * 5 + 3050).toLocaleString("en-IN") : "3,050" %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reviews Section -->
  <div class="row mt-5 pt-4 border-top">
    <div class="col-12 mb-4">
      <h4 class="fw-bold">
        <i class="fa-solid fa-star text-warning me-2"></i>4.92 &middot; <%= listing.reviews ? listing.reviews.length : 0 %> Reviews
      </h4>
    </div>

    <!-- Leave Review Form -->
    <div class="col-lg-6 mb-4">
      <div class="card p-4 border rounded-4 shadow-sm h-100">
        <h5 class="fw-bold mb-3">Leave a Review</h5>
        <% if (currUser) { %>
          <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
              <label class="form-label d-block fw-semibold mb-2">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <div class="mb-3">
              <label for="comment" class="form-label fw-semibold">Your Experience</label>
              <textarea
                class="form-control"
                id="comment"
                name="review[comment]"
                rows="4"
                placeholder="Write your honest review about the amenities, host, and location..."
                required
              ></textarea>
              <div class="invalid-feedback">Please enter a review comment.</div>
            </div>

            <button type="submit" class="btn btn-dark rounded-pill px-4">
              Submit Review
            </button>
          </form>
        <% } else { %>
          <div class="text-center py-4 my-auto">
            <i class="fa-regular fa-comment-dots fs-1 text-muted mb-2"></i>
            <p class="text-muted mb-3">Please sign in to leave a review for this listing.</p>
            <a href="/login" class="btn btn-outline-dark rounded-pill px-4">Log in to Review</a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- All Reviews Cards Grid -->
    <div class="col-lg-6 mb-4">
      <% if (listing.reviews && listing.reviews.length > 0) { %>
        <div class="row g-3">
          <% for (let review of listing.reviews) { %>
            <div class="col-12">
              <div class="card review-card">
                <div class="card-body p-0">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="review-author-avatar">
                        <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                      </div>
                      <div>
                        <h6 class="fw-bold mb-0">@<%= review.author ? review.author.username : 'Anonymous' %></h6>
                        <small class="text-muted">Verified Guest</small>
                      </div>
                    </div>

                    <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                      <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Delete Review">
                          <i class="fa-solid fa-trash"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>

                  <p class="starability-result star mb-2" data-rating="<%= review.rating %>">
                    Rated: <%= review.rating %> stars
                  </p>

                  <p class="card-text text-secondary small mb-0">
                    <%= review.comment %>
                  </p>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="card p-4 border rounded-4 shadow-sm text-center h-100 d-flex justify-content-center align-items-center">
          <i class="fa-regular fa-star fs-1 text-muted mb-2"></i>
          <h6 class="fw-bold">No reviews yet</h6>
          <p class="text-muted small mb-0">Be the first guest to review this wonderful stay!</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Fullscreen Photo Gallery Lightbox Modal -->
<div class="modal fade" id="galleryModal" tabindex="-1" aria-labelledby="galleryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-fullscreen-lg-down">
    <div class="modal-content bg-dark text-white border-0 rounded-4 overflow-hidden shadow-lg">
      <!-- Modal Header -->
      <div class="modal-header border-secondary px-4 py-3 bg-black d-flex justify-content-between align-items-center">
        <div>
          <h5 class="modal-title fw-bold mb-0 text-white" id="galleryModalLabel">
            <i class="fa-solid fa-camera-retro text-danger me-2"></i><%= listing.title %>
          </h5>
          <small class="text-secondary">
            Photo <span id="galleryCounter" class="fw-bold text-white">1</span> of <b><%= allPhotos.length %></b>
          </small>
        </div>
        <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Modal Body: Carousel -->
      <div class="modal-body p-0 bg-black position-relative d-flex align-items-center justify-content-center" style="min-height: 480px;">
        <div id="listingGalleryCarousel" class="carousel slide w-100" data-bs-ride="false" data-bs-interval="false">
          <div class="carousel-inner text-center">
            <% allPhotos.forEach((photo, idx) => { %>
              <div class="carousel-item <%= idx === 0 ? 'active' : '' %>" data-slide-number="<%= idx + 1 %>">
                <img src="<%= photo.url %>" class="modal-gallery-img" alt="<%= listing.title %> photo <%= idx + 1 %>">
              </div>
            <% }); %>
          </div>

          <!-- Carousel Next / Prev Controls -->
          <% if (allPhotos.length > 1) { %>
            <button class="carousel-control-prev" type="button" data-bs-target="#listingGalleryCarousel" data-bs-slide="prev" aria-label="Previous">
              <span class="carousel-control-prev-icon p-3 bg-dark bg-opacity-75 rounded-circle" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#listingGalleryCarousel" data-bs-slide="next" aria-label="Next">
              <span class="carousel-control-next-icon p-3 bg-dark bg-opacity-75 rounded-circle" aria-hidden="true"></span>
            </button>
          <% } %>
        </div>
      </div>

      <!-- Modal Footer: Filmstrip Thumbnails -->
      <% if (allPhotos.length > 1) { %>
        <div class="modal-footer border-secondary px-4 py-2 bg-black justify-content-center">
          <div class="d-flex gap-2 overflow-x-auto py-1" style="max-width: 100%;">
            <% allPhotos.forEach((photo, idx) => { %>
              <img 
                src="<%= photo.url %>" 
                class="filmstrip-thumb <%= idx === 0 ? 'active' : '' %>" 
                data-target-slide="<%= idx %>" 
                alt="Thumbnail <%= idx + 1 %>"
              >
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const galleryCarousel = document.getElementById("listingGalleryCarousel");
    const galleryCounter = document.getElementById("galleryCounter");
    const filmstripThumbs = document.querySelectorAll(".filmstrip-thumb");
    const galleryModal = document.getElementById("galleryModal");

    if (galleryCarousel && galleryCounter) {
      galleryCarousel.addEventListener("slid.bs.carousel", (e) => {
        const activeItem = e.relatedTarget;
        const slideNum = activeItem.getAttribute("data-slide-number") || 1;
        galleryCounter.textContent = slideNum;

        // Update active filmstrip thumbnail
        const activeIdx = parseInt(slideNum) - 1;
        filmstripThumbs.forEach((thumb, idx) => {
          if (idx === activeIdx) {
            thumb.classList.add("active");
            thumb.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
          } else {
            thumb.classList.remove("active");
          }
        });
      });

      // Click on filmstrip thumbnail jumps to slide
      filmstripThumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const targetSlide = parseInt(thumb.getAttribute("data-target-slide"));
          const carouselInstance = bootstrap.Carousel.getOrCreateInstance(galleryCarousel);
          carouselInstance.to(targetSlide);
        });
      });
    }

    // When clicking any tile in the mosaic, open modal at that specific photo
    const mosaicTiles = document.querySelectorAll("[data-photo-idx]");
    mosaicTiles.forEach((tile) => {
      tile.addEventListener("click", () => {
        const photoIdx = parseInt(tile.getAttribute("data-photo-idx")) || 0;
        if (galleryCarousel) {
          const carouselInstance = bootstrap.Carousel.getOrCreateInstance(galleryCarousel);
          carouselInstance.to(photoIdx);
        }
      });
    });
  });
</script>